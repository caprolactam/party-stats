{
  "name": "party-stats",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:analysis": "react-router build --mode analysis",
    "preview": "npm run build && vite preview",
    "preview:wrangler": "npm run build && wrangler dev",
    "test": "vitest --run",
    "test:ui": "vitest --run --config vitest.ui.config.ts",
    "test:watch": "vitest --watch",
    "test:ui:watch": "vitest --watch --config vitest.ui.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint && eslint",
    "lint:fix": "oxlint --fix && eslint --fix",
    "typegen": "run-s typegen:*",
    "typegen:cloudflare": "wrangler types",
    "typegen:react-router": "react-router typegen",
    "typecheck": "npm run typegen && tsc",
    "setup:seed": "wrangler d1 migrations apply party-stats-db --local",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "npm run lint:fix"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-router/fs-routes": "^7.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.4",
    "isbot": "^5.1.29",
    "lucide-react": "^0.535.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.7.1",
    "recharts": "^3.1.0",
    "tailwind-merge": "^3.3.1",
    "tiny-invariant": "^1.3.3",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@cloudflare/vite-plugin": "^1.11.0",
    "@cloudflare/vitest-pool-workers": "0.8.59",
    "@react-router/dev": "^7.7.1",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-istanbul": "^3.2.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.32.0",
    "eslint-plugin-better-tailwindcss": "^3.7.3",
    "eslint-plugin-import-x": "^4.16.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.9.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.1.0",
    "vite": "^7.0.6",
    "vite-plugin-babel": "^1.3.2",
    "vite-plugin-icons-spritesheet": "^3.0.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "4.27.0"
  }
}