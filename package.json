{
  "name": "party-stats",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:host": "react-router dev --host 0.0.0.0",
    "build": "react-router build",
    "build:analysis": "react-router build --mode analysis",
    "check-bundle-size": "wrangler deploy ./build/server/index.js --dry-run --config ./build/server/wrangler.json",
    "preview": "vite preview",
    "preview:wrangler": "wrangler dev",
    "test": "vitest --run --browser.headless",
    "test:unit": "vitest --run --project unit",
    "test:browser": "vitest --run --project browser",
    "test:browser:headless": "vitest --run --project browser --browser.headless",
    "test:coverage": "vitest run --coverage --browser.headless",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:install-deps": "npx playwright install --with-deps webkit",
    "lint": "oxlint && eslint",
    "lint:fix": "oxlint --fix && eslint --fix",
    "typegen": "run-p typegen:*",
    "typegen:cloudflare": "wrangler types",
    "typegen:react-router": "react-router typegen",
    "typecheck": "npm run typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply party-stats --local",
    "db:seed": "tsx ./scripts/seed/index.ts",
    "db:seed:sql": "tsx ./scripts/seed/index.ts --mode=sql",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "npm run lint:fix"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-router/fs-routes": "^7.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color2k": "^2.0.3",
    "drizzle-orm": "^0.44.5",
    "isbot": "^5.1.30",
    "lucide-react": "^0.542.0",
    "merge-refs": "^2.0.0",
    "motion": "^12.23.12",
    "neverthrow": "^8.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-aria-components": "^1.12.1",
    "react-dom": "^19.1.1",
    "react-remove-scroll": "^2.7.1",
    "react-router": "^7.8.2",
    "recharts": "^3.1.2",
    "spin-delay": "^2.0.1",
    "tailwind-merge": "^3.3.1",
    "tiny-invariant": "^1.3.3",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@cloudflare/vite-plugin": "^1.12.3",
    "@playwright/test": "^1.55.0",
    "@react-router/dev": "^7.8.2",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@tailwindcss/vite": "^4.1.13",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-istanbul": "^3.2.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "eslint-plugin-better-tailwindcss": "^3.7.6",
    "eslint-plugin-import-x": "^4.16.1",
    "execa": "^9.6.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^16.1.6",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.14.0",
    "playwright": "^1.55.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "scule": "^1.3.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-babel": "^1.3.2",
    "vite-plugin-icons-spritesheet": "^3.0.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "vitest-browser-react": "^1.0.1",
    "wrangler": "4.34.0"
  }
}
